RUST_LOG=info

# Canonical WhatsApp JID shown by `wa-calendar-agent pair`, e.g. 15551234567@s.whatsapp.net or 1234@lid.
OWNER_JID=
WHATSAPP_SESSION_DATABASE_PATH=wa-session.db
DATABASE_URL=sqlite://wa-calendar.db

# Gemini parses text and voice notes into events.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a separate model for voice notes (defaults to GEMINI_MODEL).
GEMINI_AUDIO_MODEL=gemini-3.6-flash
# Tried in order when a model is overloaded or unavailable (one retry pass after that).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest

# Google Calendar via a service account. Share your calendar with the service
# account's email ("Make changes to events") and set GOOGLE_CALENDAR_ID to your
# calendar's ID (your Gmail address for the main calendar). See docs/GOOGLE_SETUP.md.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=service-account.json
GOOGLE_CALENDAR_ID=

# Optional Google Keep sync through keep-bridge/ (leave empty to disable).
KEEP_BRIDGE_URL=
KEEP_BRIDGE_TOKEN=

REQUEST_TIMEOUT_SECONDS=30
USER_TIMEZONE=Asia/Kolkata
DEFAULT_EVENT_DURATION_MINUTES=60
CONFIRMATION_TTL_MINUTES=30
REMINDER_POLL_SECONDS=15
